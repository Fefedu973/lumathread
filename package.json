{
  "name": "lumathread",
  "version": "0.1.0",
  "private": true,
  "description": "A composable WebGL luminous filament renderer for React.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/lumathread.js",
  "module": "./dist/lumathread.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lumathread.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "build:site": "vite build --config vite.site.config.ts && node scripts/create-static-routes.mjs && bun run registry:build",
    "check": "tsc --noEmit && biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "ci": "bun run check && bun run test && bun run registry:validate && bun run build && bun run build:site && bun run video:check",
    "preview": "vite preview",
    "registry:build": "shadcn build registry.json --output site-dist/r",
    "registry:validate": "shadcn registry validate registry.json",
    "video:dev": "bun run --cwd apps/video dev",
    "video:check": "bun run --cwd apps/video check",
    "video:render": "bun run --cwd apps/video render"
  },
  "peerDependencies": {
    "react": ">=18.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@biomejs/biome": "^2.3.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9"
  }
}
