{
  "name": "lumathread",
  "version": "0.1.0",
  "private": true,
  "description": "A composable WebGL luminous filament renderer for React.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/lumathread.js",
  "module": "./dist/lumathread.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lumathread.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && biome check .",
    "format": "biome format --write .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
